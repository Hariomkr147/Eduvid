# Copy to .env (chmod 600). Never commit .env.
DOMAIN=                      # empty -> <ip-with-dashes>.sslip.io, e.g. 34-124-165-200.sslip.io
ACME_EMAIL=                  # optional; not sent unless added to the Caddyfile

POSTGRES_USER=eduvid
POSTGRES_PASSWORD=change-me
POSTGRES_DB=eduvid
DATABASE_URL=postgresql://eduvid:change-me@postgres:5432/eduvid

S3_ENDPOINT=http://minio:9000
S3_BUCKET=eduvid
S3_ACCESS_KEY=eduvid
S3_SECRET_KEY=change-me-at-least-8-chars

SPEECH_API_URL=http://speech-api:8000
ENGINE_OMNIVOICE_URL=http://tts-omnivoice:8000
ENGINE_KOKORO_URL=http://tts-kokoro:8000
ENGINE_ASR_URL=http://asr-whisperx:8000
PIPELINE_API_KEY=            # created in Task 11: manage_keys.py create --name pipeline --scopes tts,stt --pipeline

ENGINE_INDICF5_URL=http://tts-indicf5:8000
SPEECH_API_DOCS=0            # 1 serves /speech/docs and /speech/openapi.json

# EduVid Studio
STUDIO_PASSWORD=             # builder login
STUDIO_SECRET=               # optional: signs login cookies (default: derived from STUDIO_PASSWORD + PIPELINE_API_KEY)
OPENROUTER_API_KEY=
NCERT_DATABASE_URL=          # GyanSetu Postgres, read-only

BACKUP_GCS_BUCKET=gs://<project>-eduvid-backup

# Alerts from infra/monitor.sh and infra/disk_alarm.sh (see infra/alert.sh): an ntfy topic URL, or a Slack /
# Google Chat / Discord incoming-webhook URL. Empty: alerts go only to syslog and /srv/eduvid/data/alerts.log.
ALERT_WEBHOOK_URL=

# Hugging Face read token (needed for gated models: ai4bharat/indic-parler-tts, ai4bharat/IndicF5)
# HF_TOKEN=hf_...   (uncomment and set; an empty value breaks huggingface_hub)
